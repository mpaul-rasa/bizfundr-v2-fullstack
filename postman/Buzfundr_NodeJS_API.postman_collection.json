          "request": {
            "method": "GET",
            "url": "{{base}}/vault/{{vault_address}}"
          }
        },
        {
          "name": "A15. Event History (should show PlatformFeeCollected + FundsReleased)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var j=pm.response.json();",
                  "var types = j.history.map(e => e.type);",
