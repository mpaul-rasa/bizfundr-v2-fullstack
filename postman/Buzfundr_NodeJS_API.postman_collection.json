{
  "info": {
    "name": "Buzfundr Node.js Blockchain API — Complete",
    "description": "Direct Node.js API (Port 3001). All scenarios automated with auto-save variables.\n\n## Setup\n1. Start Hardhat: npx hardhat node\n2. Deploy: npx hardhat run scripts/deploy.js --network localhost\n3. Copy USDC to .env, start: npm start\n4. Import this collection + environment\n5. Run scenarios in order\n\n## Auto-Save\nVault addresses and tx hashes are auto-saved to environment variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "apikey", "apikey": [{ "key": "key", "value": "X-API-Key" }, { "key": "value", "value": "{{api_key}}" }, { "key": "in", "value": "header" }] },
  "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
    "if(pm.response.code < 300) {",
    "  try {",
    "    var j = pm.response.json();",
    "    if(j.vault_address) pm.environment.set('vault_address', j.vault_address);",
    "    if(j.tx_hash) pm.environment.set('last_tx', j.tx_hash);",
    "    pm.test('Success', function(){ pm.expect(j.success).to.be.true; });",
    "  } catch(e) {}",
    "}"
  ]}}],
  "item": [
    {
      "name": "🏥 Health & Info",
      "item": [
        { "name": "Health Check", "request": { "auth":{"type":"noauth"}, "method": "GET", "url": "{{base}}/health" } },
        { "name": "Get Contract ABI (for frontend)", "request": { "auth":{"type":"noauth"}, "method": "GET", "url": "{{base}}/abi" } },
        { "name": "Get Blockchain Time", "request": { "method": "GET", "url": "{{base}}/time" } },
        { "name": "Auth Test (should 401)", "request": { "auth":{"type":"noauth"}, "method": "GET", "url": "{{base}}/vaults" } }
      ]
    },
    {
      "name": "✅ SCENARIO A — Happy Path (Invest → Release)",
      "description": "Goal reached → Issuer gets all funds.\nRun A1→A12 in order.",
      "item": [
        { "name": "A1. Recharge Investor1 with 5000 USDC",
          "event": [{"listen":"test","script":{"exec":["var j=pm.response.json(); pm.test('Recharged', ()=> pm.expect(j.success).to.be.true);"]}}],
          "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}],
          "body": {"mode":"raw","raw":"{\n  \"wallet_address\": \"{{investor1}}\",\n  \"amount_usdc\": 5000\n}"},
          "url": "{{base}}/recharge" }
        },
        { "name": "A2. Check Investor1 Balance (should be 5000)",
          "request": { "method": "GET", "url": "{{base}}/wallet/{{investor1}}" }
        },
        { "name": "A3. Deploy Vault (goal=1000, cap=10000, deadline=120s)",
          "event": [{"listen":"test","script":{"exec":[
            "var j=pm.response.json();",
            "if(j.vault_address) {",
            "  pm.environment.set('vault_address', j.vault_address);",
            "  console.log('Saved vault:', j.vault_address);",
            "}",
            "pm.test('Vault deployed', ()=> pm.expect(j.success).to.be.true);"
          ]}}],
          "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}],
          "body": {"mode":"raw","raw":"{\n  \"min_goal_usdc\": 1000,\n  \"max_cap_usdc\": 10000,\n  \"max_per_investor\": 2500,\n  \"duration_seconds\": 120,\n  \"refund_window_seconds\": 60,\n  \"issuer_wallet\": \"{{issuer}}\"\n}"},
          "url": "{{base}}/deploy-vault" }
        },
        { "name": "A4. Check Vault Status (should be active, 0 raised)",
          "request": { "method": "GET", "url": "{{base}}/vault/{{vault_address}}" }
        },
        { "name": "A5. Invest 1500 USDC (Investor1)",
          "event": [{"listen":"test","script":{"exec":[
            "var j=pm.response.json();",
            "pm.test('Invested', ()=> pm.expect(j.success).to.be.true);",
            "if(j.tx_hash) pm.environment.set('invest_tx', j.tx_hash);"
          ]}}],
          "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}],
          "body": {"mode":"raw","raw":"{\n  \"vault_address\": \"{{vault_address}}\",\n  \"investor_wallet\": \"{{investor1}}\",\n  \"amount_usdc\": 1500,\n  \"risk_acknowledgement_completed\": true,\n  \"offering_document_confirmed\": true,\n  \"subscription_agreement_signed\": true,\n  \"subscription_timestamp\": \"2025-03-01T10:00:00Z\"\n}"},
          "url": "{{base}}/invest" }
        },
        { "name": "A6. Check Investor1 Info (deposit=1500, refund eligible)",
          "request": { "method": "GET", "url": "{{base}}/vault/{{vault_address}}/investor/{{investor1}}" }
        },
        { "name": "A7. Check Vault (total=1500, goal_reached=true)",
          "event": [{"listen":"test","script":{"exec":[
            "var j=pm.response.json();",
            "pm.test('Goal reached', ()=> pm.expect(j.goal_reached).to.be.true);",
            "pm.test('Total 1500', ()=> pm.expect(j.total_deposited_usdc).to.eql('1500.0'));"
          ]}}],
          "request": { "method": "GET", "url": "{{base}}/vault/{{vault_address}}" }
        },
        { "name": "A8. ⏩ Advance Time 130s (past 120s deadline)",
          "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}],
          "body": {"mode":"raw","raw":"{\n  \"seconds\": 130\n}"},
          "url": "{{base}}/time/advance" }
        },
        { "name": "A9. Check Vault (deadline_passed=true)",
          "event": [{"listen":"test","script":{"exec":[
            "var j=pm.response.json();",
            "pm.test('Deadline passed', ()=> pm.expect(j.deadline_passed).to.be.true);",
            "pm.test('Status ready_to_release', ()=> pm.expect(j.status).to.eql('ready_to_release'));"
          ]}}],
          "request": { "method": "GET", "url": "{{base}}/vault/{{vault_address}}" }
        },
        { "name": "A10. 🚀 Release Funds to Issuer",
          "event": [{"listen":"test","script":{"exec":[
            "var j=pm.response.json();",
            "pm.test('Released', ()=> pm.expect(j.success).to.be.true);",
            "pm.test('Amount 1500', ()=> pm.expect(j.amount_released_usdc).to.eql('1500.0'));"
          ]}}],
          "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}],
          "body": {"mode":"raw","raw":"{\n  \"vault_address\": \"{{vault_address}}\",\n  \"issuer_wallet\": \"{{issuer}}\"\n}"},
          "url": "{{base}}/release" }
        },
        { "name": "A11. Check Issuer Balance (received 1500 USDC)",
          "request": { "method": "GET", "url": "{{base}}/wallet/{{issuer}}" }
        },
        { "name": "A12. Check Vault (status=released, CLOSED)",
          "event": [{"listen":"test","script":{"exec":[
            "var j=pm.response.json();",
            "pm.test('Released', ()=> pm.expect(j.is_released).to.be.true);",
            "pm.test('Closed', ()=> pm.expect(j.is_active).to.be.false);"
          ]}}],
          "request": { "method": "GET", "url": "{{base}}/vault/{{vault_address}}" }
        },
        { "name": "A13. Full Event History",
          "request": { "method": "GET", "url": "{{base}}/vault/{{vault_address}}/history" }
        }
      ]
    },
