        },
        {
          "name": "A4. Deploy Vault (goal=1000, cap=10000, deadline=120s)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var j=pm.response.json();",
                  "if(j.vault_address) {",
                  "  pm.environment.set('vault_address', j.vault_address);",
                  "  console.log('Saved vault:', j.vault_address);",
                  "}",
                  "pm.test('Vault deployed', ()=> pm.expect(j.success).to.be.true);",
                  "pm.test('Fee wallet set', ()=> pm.expect(j.platform_fee_wallet).to.not.be.undefined);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"min_goal_usdc\": 1000,\n  \"max_cap_usdc\": 10000,\n  \"max_per_investor\": 2500,\n  \"duration_seconds\": 120,\n  \"refund_window_seconds\": 60,\n  \"issuer_wallet\": \"{{issuer}}\"\n}"
            },
            "url": "{{base}}/deploy-vault"
          }
        },
        {
          "name": "A5. Check Fee Info (estimated fee before invest = 0)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var j=pm.response.json();",
                  "pm.test('Fee percent is 7', ()=> pm.expect(j.fee_percent).to.eql(7));",
                  "pm.test('Fee wallet matches', ()=> pm.expect(j.fee_wallet.toLowerCase()).to.eql(pm.environment.get('fee_wallet').toLowerCase()));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base}}/vault/{{vault_address}}/fees"
          }
        },
        {
